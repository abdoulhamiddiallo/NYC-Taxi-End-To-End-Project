        "linkedService": {
          "name": "WH_NYC_Taxi",
          "properties": {
            "annotations": [],
            "type": "DataWarehouse",
            "typeProperties": {
              "endpoint": "darotj3cokvunnehuukvqdnj7i-bxedagivo43u7mhoxpakuzsxqm.datawarehouse.fabric.microsoft.com",
              "artifactId": "8b90142e-bd44-4141-99b9-1e81dc7da692",
              "workspaceId": "1930c80d-7715-4f37-b0ee-bbc0aa665783"
            }
          }
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "NonQuery",
              "text": "IF NOT EXISTS (SELECT 1 FROM sys.stats WHERE name = 'st_fact_trip_date') CREATE STATISTICS st_fact_trip_date ON fact.fact_trip (date_key);\nUPDATE STATISTICS fact.fact_trip (st_fact_trip_date);\n"
            },
            {
              "type": "NonQuery",
              "text": "IF NOT EXISTS (SELECT 1 FROM sys.stats WHERE name = 'st_fact_trip_pickup_zone') CREATE STATISTICS st_fact_trip_pickup_zone ON fact.fact_trip (pickup_zone_key);\nUPDATE STATISTICS fact.fact_trip (st_fact_trip_pickup_zone);\n"
            },
            {
              "type": "NonQuery",
              "text": "IF NOT EXISTS (SELECT 1 FROM sys.stats WHERE name = 'st_fact_trip_dropoff_zone') CREATE STATISTICS st_fact_trip_dropoff_zone ON fact.fact_trip (dropoff_zone_key);\nUPDATE STATISTICS fact.fact_trip (st_fact_trip_dropoff_zone);\n"
            },
            {
              "type": "NonQuery",
              "text": "IF NOT EXISTS (SELECT 1 FROM sys.stats WHERE name = 'st_fact_trip_month') CREATE STATISTICS st_fact_trip_month ON fact.fact_trip (month_number);\nUPDATE STATISTICS fact.fact_trip (st_fact_trip_month);\n"
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        }
